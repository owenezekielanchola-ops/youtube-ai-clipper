# Environment variables & API keys
.env
.env.*
!.env.example
backend/.env
frontend/.env
cookies.txt
*.cookies.txt
backend/cookies.txt

# Local runtime media, transcripts, projects, and exports (keep .gitkeep placeholders)
workspace_data/**/*
!workspace_data/**/
!workspace_data/**/.gitkeep
workspace_data/**/*.mp4
workspace_data/**/*.mp3
workspace_data/**/*.wav
workspace_data/**/*.ogg
workspace_data/**/*.m4a
workspace_data/**/*.ass
workspace_data/**/*.srt
workspace_data/**/*.vtt
workspace_data/**/*.json
workspace_data/**/_tmp_*/
workspace_data/.bin/
!workspace_data/sfx/*.mp3
!workspace_data/sfx/library.json
workspace_data/sfx/tts_*.mp3

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
